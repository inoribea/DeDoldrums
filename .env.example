# ── Role-based LLM Configuration ──
# Format: PROVIDER/MODEL_ID
# Supported providers: openai, anthropic, deepseek, zhipu, openai-completion, google
LLM_TOOL_CALLING=openai/gpt-5.5              # core loop, tool-calling via OpenAI Responses API
LLM_CREATIVE=anthropic/claude-sonnet-5       # creative divergence, via Claude Messages API
LLM_CONVERSATIONAL=openai/gpt-5.5-mini       # conversational output, cheaper model
LLM_CONTENT_REVIEW=openai/gpt-5.5            # adversarial review, precision-focused

# ── Provider API Keys ──
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GOOGLE_API_KEY=...
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# ── Bridge Server ──
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=14168
BRIDGE_API_KEY=  # optional

# ── Platform Adapters ──
TELEGRAM_BOT_TOKEN=  # optional
DISCORD_BOT_TOKEN=   # optional
